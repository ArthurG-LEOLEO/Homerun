---
import { type SbBlokData, storyblokEditable } from "@storyblok/astro";

const { language, blok } = Astro.props;
---

<div class="container-main py-50 md:py-100">
    <div class="px-gutter">
        <div id="soro-blog"></div>
    </div>
</div>

<script is:inline>
    function loadSoro() {
        const container = document.getElementById("soro-blog");
        if (!container) return;

        // Avoid loading the script multiple times
        if (document.querySelector("script[data-soro]")) {
            return;
        }

        const script = document.createElement("script");
        script.src =
            "https://app.trysoro.com/api/embed/b5c82367-4689-4279-9622-056e51f5bb91";
        script.defer = true;
        script.dataset.soro = "";
        document.body.appendChild(script);
    }

    // Initial load + after each View Transition navigation
    document.addEventListener("astro:page-load", loadSoro);
</script>
